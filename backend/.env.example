NODE_ENV=development
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/payment-engine.sqlite

# Required. Value sent by SePay as: Authorization: Apikey <this value>
# Generate a long random string; configure the SAME value in the SePay
# dashboard webhook settings. Never commit the real value.
SEPAY_WEBHOOK_API_KEY=change-me-to-a-long-random-secret

# Port the desktop app connects to for real-time PAYMENT_RECEIVED events.
DESKTOP_EVENT_WS_PORT=3001

WEBHOOK_BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
