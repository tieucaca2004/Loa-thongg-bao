{
  "name": "atieu-payment-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A Tieu Payment Engine V1 - Windows desktop app (receives PAYMENT_RECEIVED events, speaks TTS)",
  "author": "A Tieu",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && cp dist-preload/preload.js dist/preload.cjs && rm -rf dist-preload && mkdir -p dist/renderer && cp src/renderer/index.html src/renderer/renderer.js dist/renderer/ && cp build-resources/icon.png dist/renderer/icon.png",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.preload.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/ws": "^8.5.12",
    "electron": "^32.1.2",
    "electron-builder": "^25.1.8",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  },
  "build": {
    "appId": "vn.atieu.payment-desktop",
    "productName": "A Tieu Payment",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "!dist/__tests__/**",
      "package.json"
    ],
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
